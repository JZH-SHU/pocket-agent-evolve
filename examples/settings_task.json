{
  "backend": "fixture",
  "task": {
    "objective": "Enable Wi-Fi",
    "allowed_tools": [
      "android_get_ui_tree",
      "android_tap"
    ],
    "contract": {
      "postconditions": [
        {
          "path": "/elements",
          "op": "contains",
          "value": {
            "id": "wifi",
            "value": true
          }
        }
      ],
      "invariants": [
        {
          "path": "/elements/0/value",
          "op": "unchanged"
        }
      ]
    }
  },
  "initial_state": {
    "package": "local.settings",
    "elements": [
      {
        "id": "decoy",
        "text": "Bluetooth",
        "value": false,
        "protected": true
      },
      {
        "id": "wifi",
        "text": "Wi-Fi",
        "value": false
      }
    ]
  }
}
